# Copy this file to terraform.tfvars (gitignored) and fill in real values.
# NEVER commit a token.

cloudflare_api_token = "replace-with-cloudflare-api-token"
zone_name            = "avramukk.com"
tunnel_name          = "homelab"

# Subdomains under zone_name published through the tunnel (DNS records).
public_hostnames = ["homelab"]
