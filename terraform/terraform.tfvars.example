# Copy this file to terraform.tfvars (gitignored) and fill in real values.
# NEVER commit a token.

cloudflare_api_token = "replace-with-cloudflare-api-token"
zone_name            = "avramukk.com"
tunnel_name          = "homelab"

# Served openly through the Cloudflare Tunnel: subdomain → in-cluster Service.
public_hostnames = {
  "homelab" = "http://landing.landing.svc.cluster.local:80"
  "status"  = "http://gatus.status.svc.cluster.local:80"
}

# Tailnet-only: DNS-only A record → tailscale_ip, routed by Traefik. Not proxied.
private_hostnames = {
  "grafana" = "kube-prometheus-stack-grafana.observability.svc.cluster.local"
}

# Tailscale (tailnet) IP of the cluster host.
tailscale_ip = "100.x.y.z"

# Names that resolve through the tunnel but serve nothing (catch-all 404).
reserved_hostnames = []
